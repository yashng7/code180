{
  "cases": [
    {
      "args": [[-1, 0, 1, 2, -1, -4]],
      "expected": [[-1, -1, 2], [-1, 0, 1]],
      "note": "classic example"
    },
    {
      "args": [[]],
      "expected": [],
      "note": "empty input"
    },
    {
      "args": [[0]],
      "expected": [],
      "note": "single element"
    },
    {
      "args": [[0, 0, 0]],
      "expected": [[0, 0, 0]],
      "note": "all zeros"
    },
    {
      "args": [[0, 0, 0, 0]],
      "expected": [[0, 0, 0]],
      "note": "duplicate zeros collapse to one triplet"
    },
    {
      "args": [[-2, 0, 0, 2, 2]],
      "expected": [[-2, 0, 2]],
      "note": "repeated values must not duplicate a triplet"
    },
    {
      "args": [[-1, 0, 1, 0]],
      "expected": [[-1, 0, 1]],
      "note": "duplicate middle value"
    },
    {
      "args": [[3, 0, -2, -1, 1, 2]],
      "expected": [[-2, 0, 2], [-1, 0, 1], [-2, -1, 3]],
      "note": "three distinct triplets"
    }
  ]
}
