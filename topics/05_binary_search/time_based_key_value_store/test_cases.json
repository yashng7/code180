{
  "cases": [
    {
      "args": {
        "ops": ["TimeMap", "set", "get", "get", "set", "get", "get"],
        "vals": [
          [],
          ["foo", "bar", 1],
          ["foo", 1],
          ["foo", 3],
          ["foo", "bar2", 4],
          ["foo", 4],
          ["foo", 5]
        ]
      },
      "expected": [null, null, "bar", "bar", null, "bar2", "bar2"],
      "note": "official example"
    },
    {
      "args": {
        "ops": ["TimeMap", "get"],
        "vals": [[], ["nope", 1]]
      },
      "expected": [null, ""],
      "note": "unknown key returns empty string"
    },
    {
      "args": {
        "ops": ["TimeMap", "set", "get", "get", "get"],
        "vals": [[], ["foo", "bar", 5], ["foo", 1], ["foo", 5], ["foo", 10]]
      },
      "expected": [null, null, "", "bar", "bar"],
      "note": "query before the earliest timestamp"
    },
    {
      "args": {
        "ops": ["TimeMap", "set", "get", "set", "get"],
        "vals": [[], ["foo", "a", 1], ["foo", 1], ["foo", "b", 1], ["foo", 1]]
      },
      "expected": [null, null, "a", null, "b"],
      "note": "same timestamp overwritten, latest wins"
    },
    {
      "args": {
        "ops": ["TimeMap", "set", "set", "get", "get", "get"],
        "vals": [[], ["a", "x", 1], ["b", "y", 1], ["a", 1], ["b", 1], ["a", 2]]
      },
      "expected": [null, null, null, "x", "y", "x"],
      "note": "keys are independent"
    },
    {
      "args": {
        "ops": ["TimeMap", "set", "set", "set", "get", "get", "get", "get", "get", "get"],
        "vals": [
          [],
          ["k", "v1", 1],
          ["k", "v2", 5],
          ["k", "v3", 10],
          ["k", 0],
          ["k", 1],
          ["k", 4],
          ["k", 5],
          ["k", 9],
          ["k", 11]
        ]
      },
      "expected": [null, null, null, null, "", "v1", "v1", "v2", "v2", "v3"],
      "note": "queries land before, on, and between timestamps"
    },
    {
      "args": {
        "ops": ["TimeMap", "set", "get", "set", "get", "get"],
        "vals": [[], ["x", "a", 1], ["x", 1], ["x", "b", 3], ["x", 2], ["x", 3]]
      },
      "expected": [null, null, "a", null, "a", "b"],
      "note": "interleaved sets and gets"
    }
  ]
}
