{
  "cases": [
    {
      "args": [19],
      "expected": true,
      "note": "official example: 19 -> 82 -> 68 -> 100 -> 1"
    },
    {
      "args": [2],
      "expected": false,
      "note": "official example: 2 enters the 4-cycle"
    },
    {
      "args": [1],
      "expected": true,
      "note": "1 is happy by definition"
    },
    {
      "args": [7],
      "expected": true,
      "note": "single-digit happy number"
    },
    {
      "args": [100],
      "expected": true,
      "note": "trailing zeros: 1^2 = 1"
    },
    {
      "args": [4],
      "expected": false,
      "note": "starts the classic 4 -> 16 -> 37 cycle immediately"
    },
    {
      "args": [1111111],
      "expected": true,
      "note": "seven ones: sum of squares = 7, which is happy"
    }
  ]
}
