{
  "cases": [
    {
      "args": [[[1, 2, 3], [4, 5, 6], [7, 8, 9]]],
      "expected": [[7, 4, 1], [8, 5, 2], [9, 6, 3]],
      "note": "official example 3x3"
    },
    {
      "args": [[[5, 1, 9, 11], [2, 4, 8, 10], [13, 3, 6, 7], [15, 14, 12, 16]]],
      "expected": [[15, 13, 2, 5], [14, 3, 4, 1], [12, 6, 8, 9], [16, 7, 10, 11]],
      "note": "official example 4x4"
    },
    {
      "args": [[[1]]],
      "expected": [[1]],
      "note": "singleton matrix"
    },
    {
      "args": [[[1, 2], [3, 4]]],
      "expected": [[3, 1], [4, 2]],
      "note": "smallest even matrix 2x2"
    },
    {
      "args": [[[-1, -2], [-3, -4]]],
      "expected": [[-3, -1], [-4, -2]],
      "note": "all negative values"
    },
    {
      "args": [[[0, 1, 2], [3, 4, 5], [6, 7, 8]]],
      "expected": [[6, 3, 0], [7, 4, 1], [8, 5, 2]],
      "note": "distinct values with a zero, catches transpose-only bug"
    }
  ]
}
