{
  "cases": [
    {
      "args": [[1, 3, 4, 2, 2]],
      "expected": 2,
      "note": "classic example"
    },
    {
      "args": [[3, 1, 3, 4, 2]],
      "expected": 3,
      "note": "second classic example"
    },
    {
      "args": [[3, 3, 3, 3, 3]],
      "expected": 3,
      "note": "all values identical"
    },
    {
      "args": [[1, 1]],
      "expected": 1,
      "note": "minimum size n = 1"
    },
    {
      "args": [[1, 2, 3, 4, 4]],
      "expected": 4,
      "note": "duplicate at the end"
    },
    {
      "args": [[2, 2, 2, 2, 2]],
      "expected": 2,
      "note": "single repeated value filling the array"
    },
    {
      "args": [[4, 3, 1, 4, 2]],
      "expected": 4,
      "note": "duplicate at index 0 value"
    },
    {
      "args": [[1, 4, 4, 2, 3]],
      "expected": 4,
      "note": "duplicate in the middle"
    }
  ]
}
