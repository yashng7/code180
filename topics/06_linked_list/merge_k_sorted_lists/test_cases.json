{
  "cases": [
    {
      "args": [[[1, 4, 5], [1, 3, 4], [2, 6]]],
      "expected": [1, 1, 2, 3, 4, 4, 5, 6],
      "note": "classic example"
    },
    {
      "args": [[]],
      "expected": [],
      "note": "no lists at all"
    },
    {
      "args": [[[]]],
      "expected": [],
      "note": "one empty list"
    },
    {
      "args": [[[], [1], []]],
      "expected": [1],
      "note": "empty lists around a single value"
    },
    {
      "args": [[[1], [0]]],
      "expected": [0, 1],
      "note": "two single-node lists out of order"
    },
    {
      "args": [[[-3, -1], [-2, 0]]],
      "expected": [-3, -2, -1, 0],
      "note": "negative values"
    },
    {
      "args": [[[1, 2, 3], [4, 5, 6], [7, 8, 9]]],
      "expected": [1, 2, 3, 4, 5, 6, 7, 8, 9],
      "note": "disjoint ranges"
    },
    {
      "args": [[[5], [5], [5]]],
      "expected": [5, 5, 5],
      "note": "duplicate values across lists"
    }
  ]
}
