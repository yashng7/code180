{
  "cases": [
    {
      "args": [
        [
          3,
          1,
          4,
          3,
          null,
          1,
          5
        ]
      ],
      "expected": 4,
      "note": "classic example"
    },
    {
      "args": [
        [
          3,
          3,
          null,
          4,
          2
        ]
      ],
      "expected": 3,
      "note": "classic example, equal value is good"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1,
      "note": "single node is always good"
    },
    {
      "args": [
        []
      ],
      "expected": 0,
      "note": "empty tree"
    },
    {
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 3,
      "note": "all children larger than the root"
    },
    {
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": 2,
      "note": "left child is smaller"
    },
    {
      "args": [
        [
          5,
          4,
          3,
          2,
          1
        ]
      ],
      "expected": 1,
      "note": "strictly decreasing, only the root"
    },
    {
      "args": [
        [
          1,
          2,
          null,
          3,
          null,
          4
        ]
      ],
      "expected": 4,
      "note": "increasing chain, all good"
    }
  ]
}
