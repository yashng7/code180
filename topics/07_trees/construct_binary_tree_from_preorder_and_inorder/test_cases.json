        2
      ],
      "note": "right-only child"
    },
    {
      "args": [
        [
          1,
          2,
          4,
          5,
          3,
          6,
          7
        ],
        [
          4,
          2,
          5,
          1,
          6,
          3,
          7
        ]
      ],
      "expected": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "note": "balanced tree"
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        [
          3,
          2,
          1
        ]
      ],
      "expected": [
        1,
        2,
        null,
        3
      ],
      "note": "left-skewed chain"
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        null,
        2,
        null,
        3
      ],
      "note": "right-skewed chain"
    },
    {
      "args": [
        [
          -1,
