{
  "cases": [
    {
      "args": [
        [
          3,
          9,
          20,
          15,
          7
        ],
        [
          9,
          3,
          15,
          20,
          7
        ]
      ],
      "expected": [
        3,
        9,
        20,
        null,
        null,
        15,
        7
      ],
      "note": "classic example"
    },
    {
      "args": [
        [
          1
        ],
        [
          1
        ]
      ],
      "expected": [
        1
      ],
      "note": "single node"
    },
    {
      "args": [
        [
          1,
          2
        ],
        [
          2,
          1
        ]
      ],
      "expected": [
        1,
        2
      ],
      "note": "left-only child"
    },
    {
      "args": [
        [
          1,
          2
        ],
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
