{
  "cases": [
    {
      "args": [
        [
          3,
          9,
          20,
          null,
          null,
          15,
          7
        ]
      ],
      "expected": true,
      "note": "classic example, balanced"
    },
    {
      "args": [
        [
          1,
          2,
          2,
          3,
          3,
          null,
          null,
          4,
          4
        ]
      ],
      "expected": false,
      "note": "classic example, unbalanced"
    },
    {
      "args": [
        []
      ],
      "expected": true,
      "note": "empty tree is balanced"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": true,
      "note": "single node"
    },
    {
      "args": [
        [
          1,
          2,
          null,
          3
        ]
      ],
      "expected": false,
      "note": "left-skewed chain of depth 3"
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          null
        ]
      ],
      "expected": true,
      "note": "diff of 1 everywhere"
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4,
          null,
          null,
          null,
          5
        ]
      ],
      "expected": false,
      "note": "deep left leaf"
    },
    {
      "args": [
        [
          1,
          2,
          2,
          3,
          null,
          null,
          3,
          4,
          null,
          null,
          4
        ]
      ],
      "expected": false,
      "note": "mirror skew"
    }
  ]
}
