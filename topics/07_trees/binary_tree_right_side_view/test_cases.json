{
  "cases": [
    {
      "args": [
        [
          1,
          2,
          3,
          null,
          5,
          null,
          4
        ]
      ],
      "expected": [
        1,
        3,
        4
      ],
      "note": "classic example"
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        1,
        3,
        4
      ],
      "note": "rightmost node is the only one on its level"
    },
    {
      "args": [
        [
          1,
          null,
          3
        ]
      ],
      "expected": [
        1,
        3
      ],
      "note": "right-leaning chain"
    },
    {
      "args": [
        []
      ],
      "expected": [],
      "note": "empty tree"
    },
    {
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
        2
      ],
      "note": "left-only child"
    },
    {
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      ],
      "expected": [
        1,
        3,
        7
      ],
      "note": "perfect tree"
    },
    {
      "args": [
        [
          1,
          2,
          null,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ],
      "note": "left-leaning chain"
    }
  ]
}
