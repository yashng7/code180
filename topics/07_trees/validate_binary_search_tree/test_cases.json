{
  "cases": [
    {
      "args": [
        [
          2,
          1,
          3
        ]
      ],
      "expected": true,
      "note": "classic valid example"
    },
    {
      "args": [
        [
          5,
          1,
          4,
          null,
          null,
          3,
          6
        ]
      ],
      "expected": false,
      "note": "classic invalid example"
    },
    {
      "args": [
        []
      ],
      "expected": true,
      "note": "empty tree is a valid BST"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": true,
      "note": "single node"
    },
    {
      "args": [
        [
          1,
          null,
          2
        ]
      ],
      "expected": true,
      "note": "increasing right chain"
    },
    {
      "args": [
        [
          2,
          null,
          1
        ]
      ],
      "expected": false,
      "note": "right child smaller than root"
    },
    {
      "args": [
        [
          5,
          4,
          6,
          null,
          null,
          3,
          7
        ]
      ],
      "expected": false,
      "note": "descendant violates an ancestor bound"
    },
    {
      "args": [
        [
          2,
          2,
          2
        ]
      ],
      "expected": false,
      "note": "duplicates are not allowed"
    }
  ]
}
