{
  "cases": [
    {
      "args": [
        [
          1,
          2,
          3,
          null,
          null,
          4,
          5
        ]
      ],
      "expected": [
        1,
        2,
        3,
        null,
        null,
        4,
        5
      ],
      "note": "classic example"
    },
    {
      "args": [
        []
      ],
      "expected": [],
      "note": "empty tree"
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": [
        1
      ],
      "note": "single node"
    },
    {
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
        2
      ],
      "note": "left-only child"
    },
    {
      "args": [
        [
          1,
          null,
          2
        ]
      ],
      "expected": [
        1,
        null,
        2
      ],
      "note": "right-only child"
    },
    {
      "args": [
        [
          1,
          2,
          3,
          null,
          null,
          null,
          4
        ]
      ],
      "expected": [
        1,
        2,
        3,
        null,
        null,
        null,
        4
      ],
      "note": "right-leaning tail"
    },
    {
      "args": [
        [
          5,
          3,
          6,
          2,
          4,
          null,
          null,
          1
        ]
      ],
      "expected": [
        5,
        3,
        6,
        2,
        4,
        null,
        null,
        1
      ],
      "note": "asymmetric tree"
    },
    {
      "args": [
        [
          -1,
          -2,
          -3
        ]
      ],
      "expected": [
        -1,
        -2,
        -3
      ],
      "note": "negative values round-trip"
    }
  ]
}
