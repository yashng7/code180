{
  "cases": [
    {
      "args": [[1, 2, 3, 4, 5], [3, 4, 5, 1, 2]],
      "expected": 3,
      "note": "classic example"
    },
    {
      "args": [[2, 3, 4], [3, 4, 3]],
      "expected": -1,
      "note": "classic example — total gas < total cost"
    },
    {
      "args": [[5], [4]],
      "expected": 0,
      "note": "single station, enough gas"
    },
    {
      "args": [[4], [5]],
      "expected": -1,
      "note": "single station, not enough gas"
    },
    {
      "args": [[3, 1, 1], [1, 2, 2]],
      "expected": 0,
      "note": "start at index 0 survives the dip to zero"
    },
    {
      "args": [[5, 1, 2, 3, 4], [4, 4, 1, 5, 1]],
      "expected": 4,
      "note": "only the last station works"
    },
    {
      "args": [[1, 1, 1, 1], [1, 1, 1, 1]],
      "expected": 0,
      "note": "every station nets zero, start at 0"
    },
    {
      "args": [[2, 0, 0], [0, 1, 1]],
      "expected": 0,
      "note": "zero gas at later stations, still completes"
    }
  ]
}
