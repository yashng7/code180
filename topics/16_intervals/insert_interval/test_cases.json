{
  "cases": [
    {
      "args": [[[1, 3], [6, 9]], [2, 5]],
      "expected": [[1, 5], [6, 9]],
      "note": "classic example"
    },
    {
      "args": [[[1, 2], [3, 5], [6, 7], [8, 10], [12, 16]], [4, 8]],
      "expected": [[1, 2], [3, 10], [12, 16]],
      "note": "bridge across several intervals"
    },
    {
      "args": [[], [5, 7]],
      "expected": [[5, 7]],
      "note": "empty input"
    },
    {
      "args": [[[1, 5]], [2, 3]],
      "expected": [[1, 5]],
      "note": "new interval fully contained"
    },
    {
      "args": [[[1, 5]], [0, 0]],
      "expected": [[0, 0], [1, 5]],
      "note": "insert before, no overlap"
    },
    {
      "args": [[[1, 5]], [6, 8]],
      "expected": [[1, 5], [6, 8]],
      "note": "insert after, no overlap"
    },
    {
      "args": [[[1, 5]], [5, 8]],
      "expected": [[1, 8]],
      "note": "touching at the right endpoint merges"
    },
    {
      "args": [[[1, 2], [5, 6]], [0, 10]],
      "expected": [[0, 10]],
      "note": "new interval swallows everything"
    },
    {
      "args": [[[3, 4]], [1, 2]],
      "expected": [[1, 2], [3, 4]],
      "note": "single existing interval, disjoint insert"
    }
  ]
}
