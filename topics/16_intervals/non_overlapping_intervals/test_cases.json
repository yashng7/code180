{
  "cases": [
    {
      "args": [[[1, 2], [2, 3], [3, 4], [1, 3]]],
      "expected": 1,
      "note": "classic example"
    },
    {
      "args": [[[1, 2], [1, 2], [1, 2]]],
      "expected": 2,
      "note": "identical duplicates"
    },
    {
      "args": [[[1, 2], [2, 3]]],
      "expected": 0,
      "note": "already non-overlapping"
    },
    {
      "args": [[[1, 2]]],
      "expected": 0,
      "note": "single interval"
    },
    {
      "args": [[[1, 100], [11, 22], [1, 11], [2, 12]]],
      "expected": 2,
      "note": "long interval dominates"
    },
    {
      "args": [[[3, 4], [2, 3], [1, 2]]],
      "expected": 0,
      "note": "descending input, no overlaps"
    },
    {
      "args": [[[0, 2], [1, 3], [1, 4], [2, 5]]],
      "expected": 2,
      "note": "clustered overlaps"
    },
    {
      "args": [[[1, 5], [2, 3], [4, 6], [7, 8]]],
      "expected": 1,
      "note": "contained interval must go"
    },
    {
      "args": [[[1, 3], [2, 4], [3, 5]]],
      "expected": 1,
      "note": "greedy-by-end beats greedy-by-start"
    }
  ]
}
