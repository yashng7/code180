{
  "cases": [
    {
      "args": [[1, 2, 2]],
      "expected": [[], [1], [1, 2], [1, 2, 2], [2], [2, 2]],
      "note": "official example"
    },
    {
      "args": [[0]],
      "expected": [[], [0]],
      "note": "singleton"
    },
    {
      "args": [[]],
      "expected": [[]],
      "note": "empty input has only the empty subset"
    },
    {
      "args": [[1, 2, 3]],
      "expected": [[], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]],
      "note": "all distinct reduces to plain Subsets"
    },
    {
      "args": [[1, 1]],
      "expected": [[], [1], [1, 1]],
      "note": "duplicate pair"
    },
    {
      "args": [[-1, 0, 0]],
      "expected": [[], [-1], [-1, 0], [-1, 0, 0], [0], [0, 0]],
      "note": "negatives plus duplicates"
    }
  ]
}
