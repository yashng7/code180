{
  "cases": [
    {
      "args": [2, [[1, 0]]],
      "expected": true,
      "note": "official example 1"
    },
    {
      "args": [2, [[1, 0], [0, 1]]],
      "expected": false,
      "note": "official example 2: two-cycle"
    },
    {
      "args": [1, []],
      "expected": true,
      "note": "single course, no prerequisites"
    },
    {
      "args": [3, []],
      "expected": true,
      "note": "no edges, no cycle"
    },
    {
      "args": [4, [[1, 0], [2, 0], [3, 1], [3, 2]]],
      "expected": true,
      "note": "diamond dependency"
    },
    {
      "args": [3, [[0, 1], [1, 2], [2, 0]]],
      "expected": false,
      "note": "three-cycle"
    },
    {
      "args": [5, [[1, 0], [2, 1], [3, 2], [4, 3]]],
      "expected": true,
      "note": "long chain, still acyclic"
    },
    {
      "args": [3, [[1, 0], [1, 2]]],
      "expected": true,
      "note": "shared dependent, no cycle"
    }
  ]
}
