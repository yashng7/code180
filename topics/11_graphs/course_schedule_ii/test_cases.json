{
  "cases": [
    {
      "args": [2, [[1, 0]]],
      "expected": [0, 1],
      "note": "official example 1 (any valid order accepted)"
    },
    {
      "args": [4, [[1, 0], [2, 0], [3, 1], [3, 2]]],
      "expected": [0, 2, 1, 3],
      "note": "official example 2 (any valid order accepted)"
    },
    {
      "args": [1, []],
      "expected": [0],
      "note": "single course"
    },
    {
      "args": [3, []],
      "expected": [0, 1, 2],
      "note": "no prerequisites, any permutation is valid"
    },
    {
      "args": [5, []],
      "expected": [0, 1, 2, 3, 4],
      "note": "five independent courses"
    },
    {
      "args": [3, [[0, 1], [1, 2], [2, 0]]],
      "expected": [],
      "note": "three-cycle: impossible, must return []"
    },
    {
      "args": [4, [[1, 0], [2, 1], [3, 2]]],
      "expected": [0, 1, 2, 3],
      "note": "linear chain forces the order"
    },
    {
      "args": [3, [[1, 0], [0, 2]]],
      "expected": [2, 0, 1],
      "note": "course 2 must come first"
    },
    {
      "args": [2, [[1, 0], [0, 1]]],
      "expected": [],
      "note": "two-cycle: impossible"
    }
  ]
}
