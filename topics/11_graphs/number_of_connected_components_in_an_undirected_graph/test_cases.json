{
  "cases": [
    {
      "args": [5, [[0, 1], [1, 2], [3, 4]]],
      "expected": 2,
      "note": "official example"
    },
    {
      "args": [5, [[0, 1], [1, 2], [2, 3], [3, 4]]],
      "expected": 1,
      "note": "path connecting all nodes"
    },
    {
      "args": [4, [[0, 1], [2, 3]]],
      "expected": 2,
      "note": "two disjoint edges"
    },
    {
      "args": [1, []],
      "expected": 1,
      "note": "single node is one component"
    },
    {
      "args": [5, []],
      "expected": 5,
      "note": "no edges: every node is isolated"
    },
    {
      "args": [3, [[0, 1], [1, 2]]],
      "expected": 1,
      "note": "three-node path"
    },
    {
      "args": [6, [[0, 1], [2, 3], [4, 5]]],
      "expected": 3,
      "note": "three separate pairs"
    },
    {
      "args": [6, [[0, 1], [2, 3], [4, 5], [0, 5]]],
      "expected": 2,
      "note": "a late edge merges two components"
    }
  ]
}
