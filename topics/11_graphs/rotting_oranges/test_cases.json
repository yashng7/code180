{
  "cases": [
    {
      "args": [[[2, 1, 1], [1, 1, 0], [0, 1, 1]]],
      "expected": 4,
      "note": "official example 1"
    },
    {
      "args": [[[2, 1, 1], [0, 1, 1], [1, 0, 1]]],
      "expected": -1,
      "note": "official example 2: bottom-left orange never rots"
    },
    {
      "args": [[[0, 2]]],
      "expected": 0,
      "note": "official example 3: nothing fresh"
    },
    {
      "args": [[[1]]],
      "expected": -1,
      "note": "lone fresh orange, no rot"
    },
    {
      "args": [[[2]]],
      "expected": 0,
      "note": "lone rotten orange"
    },
    {
      "args": [[[0]]],
      "expected": 0,
      "note": "lone empty cell"
    },
    {
      "args": [[[2, 0, 1]]],
      "expected": -1,
      "note": "empty cell blocks the rot"
    },
    {
      "args": [[[2, 2], [2, 2]]],
      "expected": 0,
      "note": "all already rotten"
    },
    {
      "args": [[[2, 1, 1], [1, 1, 1], [1, 1, 1]]],
      "expected": 4,
      "note": "single source, corner-to-corner spread"
    }
  ]
}
