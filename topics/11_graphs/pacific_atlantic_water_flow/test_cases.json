{
  "cases": [
    {
      "args": [[
        [1, 2, 2, 3, 5],
        [3, 2, 3, 4, 4],
        [2, 4, 5, 3, 1],
        [6, 7, 1, 4, 5],
        [5, 1, 1, 2, 4]
      ]],
      "expected": [[0, 4], [1, 3], [1, 4], [2, 2], [3, 0], [3, 1], [4, 0]],
      "note": "official example"
    },
    {
      "args": [[[1]]],
      "expected": [[0, 0]],
      "note": "single cell touches both oceans"
    },
    {
      "args": [[
        [1, 1, 1],
        [1, 1, 1],
        [1, 1, 1]
      ]],
      "expected": [[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2], [2, 0], [2, 1], [2, 2]],
      "note": "flat 3x3, every cell reaches both"
    },
    {
      "args": [[[1, 2], [4, 3]]],
      "expected": [[0, 1], [1, 0], [1, 1]],
      "note": "top-right, bottom-left and bottom-right qualify"
    },
    {
      "args": [[
        [1, 2, 3],
        [2, 3, 4],
        [3, 4, 5]
      ]],
      "expected": [[0, 2], [1, 2], [2, 0], [2, 1], [2, 2]],
      "note": "monotonic uphill: only the Atlantic border qualifies"
    },
    {
      "args": [[[1, 2, 3]]],
      "expected": [[0, 0], [0, 1], [0, 2]],
      "note": "single row, every cell borders both oceans"
    },
    {
      "args": [[[1], [2], [3]]],
      "expected": [[0, 0], [1, 0], [2, 0]],
      "note": "single column, every cell borders both oceans"
    }
  ]
}
