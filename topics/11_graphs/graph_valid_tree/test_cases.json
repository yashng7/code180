{
  "cases": [
    {
      "args": [5, [[0, 1], [0, 2], [0, 3], [1, 4]]],
      "expected": true,
      "note": "official example 1 (valid tree)"
    },
    {
      "args": [5, [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]]],
      "expected": false,
      "note": "official example 2 (cycle)"
    },
    {
      "args": [1, []],
      "expected": true,
      "note": "single node is a valid tree"
    },
    {
      "args": [2, []],
      "expected": false,
      "note": "two nodes with no edge are disconnected"
    },
    {
      "args": [2, [[0, 1]]],
      "expected": true,
      "note": "single edge is a tree"
    },
    {
      "args": [4, [[0, 1], [2, 3]]],
      "expected": false,
      "note": "two components, too few edges"
    },
    {
      "args": [3, [[0, 1], [1, 2]]],
      "expected": true,
      "note": "three-node path"
    },
    {
      "args": [3, [[0, 1], [0, 2], [1, 2]]],
      "expected": false,
      "note": "triangle: right edge count, but cyclic"
    },
    {
      "args": [4, [[0, 1], [1, 2], [2, 3]]],
      "expected": true,
      "note": "four-node chain"
    }
  ]
}
