{
  "cases": [
    {
      "args": [[[1, 2], [1, 3], [2, 3]]],
      "expected": [2, 3],
      "note": "official example 1: triangle closes"
    },
    {
      "args": [[[1, 2], [2, 3], [3, 4], [1, 4], [1, 5]]],
      "expected": [1, 4],
      "note": "official example 2: edge [1,4] closes the cycle"
    },
    {
      "args": [[[1, 2], [2, 3], [1, 3]]],
      "expected": [1, 3],
      "note": "three-node cycle"
    },
    {
      "args": [[[1, 2], [1, 3], [3, 4], [2, 4]]],
      "expected": [2, 4],
      "note": "cycle with a leaf attached"
    },
    {
      "args": [[[1, 2], [1, 3], [1, 4], [3, 4]]],
      "expected": [3, 4],
      "note": "star plus an extra edge"
    },
    {
      "args": [[[1, 2], [2, 3], [3, 4], [4, 5], [5, 1]]],
      "expected": [5, 1],
      "note": "five-cycle, closing edge is last"
    },
    {
      "args": [[[1, 2], [2, 3], [3, 1], [3, 4], [4, 5]]],
      "expected": [3, 1],
      "note": "cycle closes before the later tree edges"
    }
  ]
}
