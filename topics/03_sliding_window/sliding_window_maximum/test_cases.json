{
  "cases": [
    {
      "args": [[1, 3, -1, -3, 5, 3, 6, 7], 3],
      "expected": [3, 3, 5, 5, 6, 7],
      "note": "classic example"
    },
    {
      "args": [[1], 1],
      "expected": [1],
      "note": "singleton array"
    },
    {
      "args": [[1, -1], 1],
      "expected": [1, -1],
      "note": "window of size 1"
    },
    {
      "args": [[9, 11], 2],
      "expected": [11],
      "note": "window equals whole array"
    },
    {
      "args": [[4, 2, 12, 11, -5], 2],
      "expected": [4, 12, 12, 11],
      "note": "max bubbles to the front"
    },
    {
      "args": [[1, 3, 1, 2, 0, 5], 3],
      "expected": [3, 3, 2, 5],
      "note": "mixed increasing and decreasing"
    },
    {
      "args": [[1, 2, 3, 4, 5, 6, 7], 3],
      "expected": [3, 4, 5, 6, 7],
      "note": "sorted ascending"
    },
    {
      "args": [[7, 6, 5, 4, 3, 2, 1], 3],
      "expected": [7, 6, 5, 4, 3],
      "note": "sorted descending"
    }
  ]
}
