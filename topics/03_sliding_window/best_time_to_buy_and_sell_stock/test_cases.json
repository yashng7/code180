{
  "cases": [
    {
      "args": [[7, 1, 5, 3, 6, 4]],
      "expected": 5,
      "note": "classic example: buy 1 sell 6"
    },
    {
      "args": [[7, 6, 4, 3, 1]],
      "expected": 0,
      "note": "strictly decreasing, no profit"
    },
    {
      "args": [[1, 2, 3, 4, 5]],
      "expected": 4,
      "note": "strictly increasing"
    },
    {
      "args": [[2, 4, 1]],
      "expected": 2,
      "note": "best profit before the final drop"
    },
    {
      "args": [[1]],
      "expected": 0,
      "note": "singleton, cannot sell"
    },
    {
      "args": [[2, 1, 2, 1, 0, 1, 2]],
      "expected": 2,
      "note": "cheapest buy in the middle"
    },
    {
      "args": [[3, 3, 3]],
      "expected": 0,
      "note": "flat prices"
    },
    {
      "args": [[1, 100]],
      "expected": 99,
      "note": "minimum length with profit"
    }
  ]
}
