{
  "cases": [
    {
      "args": [12, [10, 8, 0, 5, 3], [2, 4, 1, 1, 3]],
      "expected": 3,
      "note": "official example 1"
    },
    {"args": [10, [3], [3]], "expected": 1, "note": "official example 2, singleton"},
    {"args": [100, [0, 2, 4], [4, 2, 1]], "expected": 1, "note": "official example 3, all merge"},
    {
      "args": [10, [6, 8], [3, 2]],
      "expected": 2,
      "note": "leading car is slower, so the trailing car never catches it"
    },
    {
      "args": [10, [0, 4, 8], [2, 2, 2]],
      "expected": 3,
      "note": "equal speeds never merge"
    },
    {
      "args": [10, [0, 4, 8], [4, 2, 1]],
      "expected": 2,
      "note": "the last car catches the fleet ahead"
    },
    {"args": [10, [0], [1]], "expected": 1, "note": "single slow car"}
  ]
}
