{
  "cases": [
    {
      "args": {
        "ops": ["KthLargest", "add", "add", "add", "add", "add"],
        "vals": [[3, [4, 5, 8, 2]], [3], [5], [10], [9], [4]]
      },
      "expected": [null, 4, 5, 5, 8, 8],
      "note": "official example"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add", "add"],
        "vals": [[1, []], [5], [3], [9]]
      },
      "expected": [null, 5, 5, 9],
      "note": "k == 1, empty initial stream"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add", "add"],
        "vals": [[4, [1, 2, 3, 4]], [5], [6], [7]]
      },
      "expected": [null, 2, 3, 4],
      "note": "k == initial length, every add pushes the answer up"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add"],
        "vals": [[2, [1, 1, 1, 1, 1]], [1], [2]]
      },
      "expected": [null, 1, 1],
      "note": "duplicates: second largest stays 1 when a 2 arrives"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add"],
        "vals": [[3, [-1, -2, -3]], [-4], [0]]
      },
      "expected": [null, -3, -2],
      "note": "negative values"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add", "add"],
        "vals": [[2, [0]], [2], [1], [3]]
      },
      "expected": [null, 0, 1, 2],
      "note": "initial stream shorter than k"
    },
    {
      "args": {
        "ops": ["KthLargest", "add", "add"],
        "vals": [[1, [0]], [0], [0]]
      },
      "expected": [null, 0, 0],
      "note": "single value with zeros"
    }
  ]
}
